# AI Discovery Engine - Environment Configuration

# Primary LLM Provider (groq)
LLM_PROVIDER=groq

# Groq API Key (get your key at https://console.groq.com)
# If empty or not provided, the application automatically runs in Offline Fallback Mode.
GROQ_API_KEY=

# Groq Model IDs
# Primary reasoning model for extraction, root-cause analysis, and clustering
GROQ_MODEL=llama-3.3-70b-versatile
# High-speed model for rapid zero-shot relevance filtering
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Force Offline Mode (True / False). If True, deterministic rules are used regardless of API key.
OFFLINE_MODE=False

# Local SQLite Database Path (relative to project root or absolute)
DB_PATH=data/app_database.sqlite

